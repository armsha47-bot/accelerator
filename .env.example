# ── Supabase ────────────────────────────────────────────────
# Project URL + anon key are safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is SERVER-ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (Claude) ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Nutritionix (food search) ───────────────────────────────
NUTRITIONIX_APP_ID=
NUTRITIONIX_API_KEY=

# ── Cron protection ─────────────────────────────────────────
# A shared secret checked by /api/cron/* routes (Vercel Cron sends it as a
# Bearer token via the `Authorization` header, or ?secret= for manual runs).
CRON_SECRET=

# ── Web Push (VAPID) ────────────────────────────────────────
# Generate with: node scripts/gen-vapid.mjs
# Public key is exposed to the browser (needed to subscribe). Private stays server.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── USDA FoodData Central (food search) ─────────────────────
# Free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
